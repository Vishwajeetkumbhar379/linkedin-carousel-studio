    "render": "Three.js r186 in headless Chromium (SwiftShader), 2x supersample, PNG with alpha"
  },
  "motion": {
    "ease": "cubic-bezier(.16,1,.3,1)",
    "hook_window_s": 2,
    "fps": 30,
    "rules": [
      "One authored moment per scene",
      "Ease-out from visible state",
      "Burned-in captions always on"
    ],
    "video_v4": {
      "template": "templates/video/motion.html",
      "beat": "one spoken line = one beat: new background (ink, violet, cobalt, peach, ivory), a transition (whip, zoom, click wipe, pop, rise), its own B-roll, camera punch then slow push",
      "b_roll": [
        "generic chat window typing a prompt and generating an image",
        "sponsored card slide-in",
        "stamp",
        "chips",
        "versus cards",
        "counter + dot field",
        "bar chart",
        "cursor click CTA",
        "mascot sprites"
      ],
      "captions": "karaoke, current word lit",
      "sound": "scripts/sfx.py: synthesised whoosh/click/pop/thump per beat + 96 bpm bed ducked under voice, -14 LUFS"
    }
  },
