    {
     "start": 0.0,
     "end": 3.64,
     "text": "Everyone's worried AI will replace the content team."
    },
    {
     "start": 4.06,
     "end": 6.52,
     "text": "I'm more worried about the brief."
    }
   ]
  },
  {
   "start": 7.22,
   "end": 14.8,
   "phrases": [
    {
     "start": 7.22,
     "end": 10.64,
     "text": "Give a great writer a vague brief, you get average work."
    },
    {
     "start": 11.06,
     "end": 14.8,
     "text": "Give AI the same brief, you get average work faster."
    }
   ]
  },
  {
   "start": 15.5,
   "end": 21.92,
   "phrases": [
    {
     "start": 15.5,
     "end": 18.61,
     "text": "Then someone sees a pile of average drafts."
    },
    {
     "start": 19.03,
     "end": 21.92,
     "text": "And decides the team was the problem."
    }
   ]
  },
  {
   "start": 22.62,
   "end": 28.47,
   "phrases": [
    {
     "start": 22.62,
     "end": 23.84,
     "text": "It wasn't the writing."
    },
    {
     "start": 24.26,
     "end": 28.47,
     "text": "Nobody decided the goal, the audience, or the one thing to say."
    }
   ]
  },
  {
   "start": 29.17,
   "end": 39.47,
   "phrases": [
    {
     "start": 29.17,
     "end": 33.86,
     "text": "Teams that brief well get more out of AI, not less work."
    },
    {
     "start": 34.28,
     "end": 35.7,
     "text": "Fix the brief first."
    },
    {
     "start": 36.12,
     "end": 39.47,
