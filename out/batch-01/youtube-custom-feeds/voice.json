   ]
  },
  {
   "start": 3.87,
   "end": 10.21,
   "phrases": [
    {
     "text": "It's called Custom Feeds.",
     "start": 3.87,
     "end": 5.72
    },
    {
     "text": "You describe a mood or an interest, and YouTube builds the feed.",
     "start": 6.04,
     "end": 10.21
