  },
  {
   "start": 16.37,
   "end": 22.35,
   "phrases": [
    {
     "text": "Why should marketers care?",
     "start": 16.37,
     "end": 18.5
    },
    {
     "text": "Because people can now ask for exactly what they want.",
     "start": 18.82,
     "end": 22.35
    }
   ]
  },
  {
   "start": 22.95,
   "end": 27.98,
   "phrases": [
    {
     "text": "Your video has to match what someone asks for,",
